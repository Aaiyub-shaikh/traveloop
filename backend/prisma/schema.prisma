generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  password     String
  profilePhoto String         @default("")
  bio          String         @default("")
  language     String         @default("en")
  theme        String         @default("system")
  currency     String         @default("USD")
  /// Master switch; when false, clients should treat all notification channels as off
  notificationsEnabled Boolean @default(true)
  /// Trip / planning-style alerts (honored when notificationsEnabled)
  notifyTripReminders  Boolean @default(true)
  /// Weekly summary emails (honored when notificationsEnabled)
  notifyWeeklyDigest   Boolean @default(false)
  createdAt    DateTime       @default(now())
  trips        Trip[]
  packingItems PackingItem[]
  savedDestinations SavedDestination[]
  tripNotes    TripNote[]
}

model Trip {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String          @default("")
  startDate   DateTime
  endDate     DateTime
  coverImage  String          @default("")
  createdAt   DateTime        @default(now())
  itinerary   Itinerary?
  budget      Budget?
  shareLink   TripShareLink?
  packingItems PackingItem[]
  notes        TripNote[]

  @@index([userId])
}

model SavedDestination {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityName  String
  country   String
  imageUrl  String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Journal entry scoped to a trip and calendar day
model TripNote {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Calendar date (UTC noon stored to reduce TZ drift)
  dayDate   DateTime
  title     String   @default("")
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId])
  @@index([userId])
  @@index([tripId, dayDate])
}

/// One public share link per trip (token in URL)
model TripShareLink {
  id        String   @id @default(uuid())
  tripId    String   @unique
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
}

enum PackingCategory {
  clothing
  electronics
  documents
  essentials
}

model PackingItem {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId    String?
  trip      Trip?           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  label     String
  category  PackingCategory
  packed    Boolean         @default(false)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId])
  @@index([tripId])
}

/// One budget per trip — expenses roll up to category breakdown (mock-friendly totals)
model Budget {
  id               String    @id @default(uuid())
  tripId           String    @unique
  trip             Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  currency         String    @default("USD")
  totalLimit       Float?
  alertAtPercent   Float     @default(90)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  expenses         Expense[]

  @@index([tripId])
}

model Expense {
  id        String   @id @default(uuid())
  budgetId  String
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category  String // hotel | transport | food | activities
  amount    Float
  label     String
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@index([budgetId])
}

/// One itinerary per trip — holds ordered stops
model Itinerary {
  id        String   @id @default(uuid())
  tripId    String   @unique
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stops     Stop[]

  @@index([tripId])
}

/// Saved cities — seeded favorites + auto-created from worldwide catalog picks
model City {
  id          String @id @default(uuid())
  worldKey    String? @unique // e.g. PT||Lisbon — matches country-state-city picks
  name        String
  country     String
  countryCode String @default("")
  stateCode   String @default("")
  tagline     String @default("")
  emoji       String @default("📍")
  stops       Stop[]
}

model Stop {
  id          String    @id @default(uuid())
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  cityId      String
  city        City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  sortOrder   Int       @default(0)
  startDate   DateTime
  endDate     DateTime
  notes       String    @default("")
  activities  Activity[]

  @@index([itineraryId])
}

model Activity {
  id          String  @id @default(uuid())
  stopId      String
  stop        Stop    @relation(fields: [stopId], references: [id], onDelete: Cascade)
  title       String
  description String  @default("")
  sortOrder   Int     @default(0)
  startsAt    String? // optional time label e.g. "09:30"

  @@index([stopId])
}
