# Leave empty for local dev — Vite proxies /api and /uploads to the backend.
# Production (e.g. Vercel): set to your deployed API origin, no trailing slash.
VITE_API_URL=

# Optional display name
# VITE_APP_NAME=Traveloop

# Dev only: override API target for Vite proxy (default http://localhost:5000)
# VITE_PROXY_TARGET=http://localhost:5000
